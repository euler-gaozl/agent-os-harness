{
  "name": "@agent-os/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:resident": "node scripts/build-resident.mjs",
    "test:resident": "node scripts/test-resident.mjs",
    "build:budget": "node scripts/build-budget.mjs",
    "test:budget": "node --test tests/budget/*.test.mjs",
    "build:native": "node scripts/build-native.mjs",
    "test:native": "node --test tests/native/*.test.mjs",
    "build:final": "node scripts/build-final.mjs",
    "test:final": "node --test tests/final/*.test.mjs",
    "build:guarded": "node scripts/build-guarded.mjs",
    "test:guarded": "node --test tests/guarded/*.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "zod": "4.6.5"
  }
}
